// Postgres twin of schema.prisma — used AUTOMATICALLY by scripts/vercel-build.sh
// whenever DATABASE_URL starts with "postgres" (i.e. on Vercel + Neon).
// Locally (SQLite) nothing changes. Keep the two files model-identical.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Department {
  id        String @id @default(cuid())
  name      String @unique
  slug      String @unique
  sortOrder Int
  // UI hint only — never gates editing.
  subType   String @default("freeform") // 'fixed' | 'freeform'
  moduleKey String @default("generic") // generic | education | research | engineering | revenue

  subdepartments Subdepartment[]
  entries        Entry[]
  goals          Goal[]
  goalMemberships GoalDepartment[]
}

model Subdepartment {
  id           String  @id @default(cuid())
  departmentId String
  name         String
  isActive     Boolean @default(true)
  sortOrder    Int
  // GPP multiplier. Default 1.0, editable in Settings (0.1–5.0), changes audited.
  valueWeight  Float   @default(1.0)

  department     Department            @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  entries        Entry[]
  weightChanges  WeightChange[]
  rivalEstimates RivalSectorEstimate[]
  goalTargets    GoalTarget[]
  goalActions    GoalAction[]

  @@unique([departmentId, name])
}

model Entry {
  id              String   @id @default(cuid())
  departmentId    String
  subdepartmentId String?
  entryTimestamp  DateTime
  durationMinutes Int
  note            String?
  obsidianRef     String?
  createdAt       DateTime @default(now())
  deletedAt       DateTime?

  department    Department    @relation(fields: [departmentId], references: [id])
  subdepartment Subdepartment? @relation(fields: [subdepartmentId], references: [id], onDelete: SetNull)
  session       WorkSession?

  @@index([entryTimestamp])
  @@index([departmentId])
  @@index([deletedAt])
}

model Goal {
  id            String   @id @default(cuid())
  departmentId  String
  title         String
  outcome       String
  whyNow        String?
  constraints   String?
  moduleKey     String   @default("generic")
  status        String   @default("active")
  priority      Int      @default(3)
  startDate     String
  targetDate    String
  reviewCadence String   @default("weekly")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  archivedAt    DateTime?
  deletedAt     DateTime?

  department Department    @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  departments GoalDepartment[]
  targets    GoalTarget[]
  problems   GoalProblem[]
  actions    GoalAction[]
  sprintLinks SprintGoal[]

  @@index([status, priority])
  @@index([departmentId])
  @@index([deletedAt])
}

model Sprint {
  id        String   @id @default(cuid())
  name      String
  phase     String?
  status    String   @default("planned") // planned | active | paused | completed | archived
  startDate String
  endDate   String
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  goals SprintGoal[]

  @@index([status, startDate])
}

model SprintGoal {
  sprintId  String
  goalId    String
  sortOrder Int      @default(0)
  addedAt   DateTime @default(now())

  sprint Sprint @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  goal   Goal   @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@id([sprintId, goalId])
  @@unique([goalId])
  @@index([goalId])
}

// An Outcome may span one or two Areas. departmentId remains the primary
// Area for legacy logs and compatibility; this join table is authoritative for
// Outcome membership going forward.
model GoalDepartment {
  goalId       String
  departmentId String
  sortOrder    Int      @default(0)

  goal       Goal       @relation(fields: [goalId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([goalId, departmentId])
  @@index([departmentId])
}

model GoalTarget {
  id              String  @id @default(cuid())
  goalId          String
  subdepartmentId String?
  label           String
  unit            String  @default("percent")
  targetValue     Float
  currentValue    Float   @default(0)
  progressSource  String  @default("manual")
  weight          Float   @default(1)
  sortOrder       Int     @default(0)

  goal          Goal           @relation(fields: [goalId], references: [id], onDelete: Cascade)
  problems      GoalProblem[]
  actions       GoalAction[]
  subdepartment Subdepartment? @relation(fields: [subdepartmentId], references: [id], onDelete: SetNull)

  @@index([goalId, sortOrder])
}

model GoalProblem {
  id        String   @id @default(cuid())
  goalId    String
  targetId  String?
  statement String
  evidence  String?
  severity  Int      @default(3)
  status    String   @default("open")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  archivedAt DateTime?

  goal    Goal         @relation(fields: [goalId], references: [id], onDelete: Cascade)
  target  GoalTarget?  @relation(fields: [targetId], references: [id], onDelete: SetNull)
  actions GoalAction[]

  @@index([goalId, status])
  @@index([archivedAt])
}

model GoalAction {
  id               String   @id @default(cuid())
  goalId           String
  targetId         String?
  problemId        String?
  subdepartmentId  String?
  title            String
  context          String   @default("deep")
  plannedMinutes   Int      @default(25)
  dueDate          String?
  status           String   @default("backlog")
  todayOrder       Int?
  definitionOfDone String?
  output           String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  archivedAt       DateTime?
  deletedAt        DateTime?

  goal          Goal           @relation(fields: [goalId], references: [id], onDelete: Cascade)
  target        GoalTarget?    @relation(fields: [targetId], references: [id], onDelete: SetNull)
  problem       GoalProblem?   @relation(fields: [problemId], references: [id], onDelete: SetNull)
  subdepartment Subdepartment? @relation(fields: [subdepartmentId], references: [id], onDelete: SetNull)
  sessions      WorkSession[]

  @@index([status, todayOrder])
  @@index([goalId])
  @@index([deletedAt])
}

model WorkSession {
  id            String    @id @default(cuid())
  actionId      String
  entryId       String?   @unique
  startedAt     DateTime  @default(now())
  endedAt       DateTime?
  status        String    @default("running") // running | completed | stopped | interrupted | abandoned
  actualMinutes Int?
  output        String?
  friction      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  action GoalAction @relation(fields: [actionId], references: [id], onDelete: Cascade)
  entry  Entry?     @relation(fields: [entryId], references: [id], onDelete: SetNull)

  @@index([status, startedAt])
  @@map("FocusSession")
}

// Workspace-level display preferences. A singleton row keeps timezone
// behavior shared across Work, Progress, History, and server-side queries.
model WorkspacePreference {
  id        Int      @id @default(1)
  timezone  String   @default("UTC")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WeeklyReview {
  id            String   @id @default(cuid())
  weekStartDate DateTime
  whatMattered  String?
  bottleneck    String?
  nextChange    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([weekStartDate])
}

model WeightChange {
  id              String   @id @default(cuid())
  subdepartmentId String
  oldWeight       Float
  newWeight       Float
  changedAt       DateTime @default(now())

  subdepartment Subdepartment @relation(fields: [subdepartmentId], references: [id], onDelete: Cascade)

  @@index([changedAt])
}

model Rival {
  id          String  @id @default(cuid())
  name        String
  regionLabel String
  notes       String?

  sectorEstimates RivalSectorEstimate[]
}

model RivalSectorEstimate {
  id                     String @id @default(cuid())
  rivalId                String
  subdepartmentId        String
  estimatedWeeklyMinutes Int

  rival         Rival         @relation(fields: [rivalId], references: [id], onDelete: Cascade)
  subdepartment Subdepartment @relation(fields: [subdepartmentId], references: [id])

  @@unique([rivalId, subdepartmentId])
}

// Optional log of unproductive time (gaming, scrolling, idle...).
// Display-only — it is carved out of the derived unproductive remainder,
// never changes any total.
// @@map keeps the original table name, so existing data survives the rename.
model UnproductiveBlock {
  id        String   @id @default(cuid())
  date      String // YYYY-MM-DD
  tag       String // activity label (free-form, suggestions in the log form)
  minutes   Int
  note      String?
  createdAt DateTime @default(now())

  @@index([date])
  @@map("UnclaimedBlock")
}

// Logged neutral time other than sleep-department entries: meals, hygiene,
// chores, commute, rest... Days with no neutral logs keep using the default
// baseline (90m) — logging replaces the assumption with reality.
model NeutralEntry {
  id        String   @id @default(cuid())
  date      String // YYYY-MM-DD
  activity  String // 'sleep' | free-form label (meals, hygiene...)
  minutes   Int
  note      String?
  createdAt DateTime @default(now())

  @@index([date])
}

// Per-day overrides for the neutral baseline. Sleep normally comes from the
// logged Sleep entry (else 8h); meals/eat-bathe is normally a flat 90m.
// Either can be pinned to a different value for one specific day.
model DayAllowance {
  id             String   @id @default(cuid())
  date           String   @unique // YYYY-MM-DD
  sleepMinutes   Int? // null = use default behavior
  neutralMinutes Int? // null = use default behavior
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
