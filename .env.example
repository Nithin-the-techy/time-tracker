# Local development database (SQLite file). On Vercel, point this at your
# hosted Turso/Neon/Supabase database instead — see VERCEL.md.
DATABASE_URL=file:./db/custom.db

# The single password that gates the whole app (login screen).
APP_PASSWORD=password

# Secret used to sign the session cookie. Generate a random 32+ char string:
#   head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n'
AUTH_SECRET=change-me-to-a-long-random-string
